APP_NAME=Data Reaper API
APP_DESCRIPTION=Data Reaper API
APP_VERSION=0.1.0
APP_ENV=development
ROOT_PATH=
CORS_ALLOW_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

MONGO_DATABASE=data_reaper
MONGO_USER=nightcrawler
MONGO_PASSWORD=change-me

RABBITMQ_USER=nightcrawler
RABBITMQ_PASSWORD=change-me
# Production gives each app its own vhost on a shared RabbitMQ.
# RABBITMQ_VHOST=/

# Host folder of validated CSVs to import, mounted read-only. Point it at
# a Night Crawler checkout to import its runs as they land, e.g.
# ../night-crawler/var/csv/validated
CSV_SOURCE_DIR=./var/csv/validated
# Rows upserted per MongoDB transaction.
IMPORT_BATCH_SIZE=500

# Grafana login (`make up-observability`); defaults to admin / admin.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Where the app pushes traces and metrics; leave empty, since
# `make up-observability` sets it (http://alloy:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Keycloak client secrets for `importer-api` and `importer-ui`. Night
# Crawler's stack runs Keycloak: these MUST match the same keys in
# ../night-crawler/.env. Compose sets KEYCLOAK_ADMIN_CLIENT_SECRET (web)
# and OIDC_CLIENT_SECRET (frontend) from them.
KC_IMPORTER_API_SECRET=change-me
KC_IMPORTER_UI_SECRET=change-me

API_BASE_URL=http://web:8000
REFLEX_API_URL=http://localhost:8101
